# Postgres connection string used by backend + Prisma (database/schema.prisma).
# Docker Compose sets this automatically for the `backend` service; only needed
# manually when running backend outside Docker against a local Postgres.
DATABASE_URL=postgresql://trades:trades@localhost:5432/trades

# Backend HTTP + WebSocket port (single server, per ADR-003).
PORT=4000

# Origin allowed by the backend's CORS middleware. Must match the URL the
# frontend is actually served from.
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend uses for REST calls.
VITE_API_BASE_URL=http://localhost:4000/api

# WebSocket URL the frontend connects to for real-time trade events.
VITE_WS_URL=ws://localhost:4000

# development | production
NODE_ENV=development
